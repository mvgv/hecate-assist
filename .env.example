# Provider da LLM: "fake" (default, sem dependencias externas) ou "ollama"
MEDASSIST_LLM_PROVIDER=fake

# Nome do modelo registrado no Ollama
MEDASSIST_MODEL=medassist

# Endpoint do Ollama (sem prefixo MEDASSIST_)
OLLAMA_BASE_URL=http://localhost:11434

# Diretorios de dados
MEDASSIST_DATA_DIR=data
MEDASSIST_DB_PATH=data/medassist.db
MEDASSIST_CHECKPOINT_PATH=data/checkpoints.db
MEDASSIST_CHROMA_DIR=data/chroma
MEDASSIST_LOG_DIR=logs

# RAG
MEDASSIST_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEDASSIST_RAG_TOP_K=4
MEDASSIST_RAG_MIN_SCORE=0.35

# Loop de regeneracao do grafo
MEDASSIST_MAX_TENTATIVAS=2

# Basic auth do Caddy (usuario:hash bcrypt) - gerar com `caddy hash-password`
CADDY_BASIC_AUTH_USER=medico
CADDY_BASIC_AUTH_HASH=

# Dominio publico da VPS (opcional). Se definido, Caddy provisiona TLS
# automatico via Let's Encrypt em :443. Se vazio, cai em HTTP puro na porta 80.
DOMAIN=
